{
  "name": "preview-all-in-one-with-quicklook",
  "displayName": "Preview All-in-One with QuickLook",
  "description": "Preview many local file types from VS Code through Windows QuickLook.",
  "version": "0.3.0",
  "publisher": "occasional16",
  "license": "AGPL-3.0-only",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.119.0"
  },
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "categories": [
    "Visualization"
  ],
  "extensionKind": [
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/occasional16/quicklook-for-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/occasional16/quicklook-for-vscode/issues"
  },
  "homepage": "https://github.com/occasional16/quicklook-for-vscode#readme",
  "galleryBanner": {
    "color": "#1E1E1E",
    "theme": "dark"
  },
  "keywords": [
    "quicklook",
    "preview",
    "windows",
    "file-preview",
    "pdf",
    "office",
    "image",
    "video",
    "markdown",
    "font",
    "archive",
    "3d",
    "design",
    "audio"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test ./out/test/**/*.test.js",
    "clean:vsix": "node ./scripts/clean-vsix.js",
    "package": "npm run clean:vsix && vsce package --no-dependencies --allow-missing-repository",
    "package:clean": "npm run package"
  },
  "contributes": {
    "configurationDefaults": {
      "workbench.editorAssociations": {
        "*.md": "vscode.markdown.preview.editor"
      },
      "workbench.diffEditorAssociations": {
        "*.md": "default"
      }
    },
    "commands": [
      {
        "command": "quicklook.previewFile",
        "title": "Preview with QuickLook",
        "category": "QuickLook",
        "icon": "$(eye)"
      },
      {
        "command": "quicklook.previewScmWorkingTree",
        "title": "Preview with QuickLook",
        "category": "QuickLook",
        "icon": "$(eye)"
      },
      {
        "command": "quicklook.previewScmIndex",
        "title": "Preview with QuickLook",
        "category": "QuickLook",
        "icon": "$(eye)"
      },
      {
        "command": "quicklook.previewScmUntracked",
        "title": "Preview with QuickLook",
        "category": "QuickLook",
        "icon": "$(eye)"
      },
      {
        "command": "quicklook.checkInstallation",
        "title": "Check QuickLook Installation",
        "category": "QuickLook",
        "icon": "$(check)"
      },
      {
        "command": "quicklook.setExecutablePath",
        "title": "Set QuickLook Executable Path",
        "category": "QuickLook",
        "icon": "$(settings-gear)"
      }
    ],
    "keybindings": [
      {
        "command": "quicklook.previewFile",
        "key": "alt+`",
        "win": "alt+`",
        "when": "filesExplorerFocus && !inputFocus"
      },
      {
        "command": "quicklook.previewFile",
        "key": "alt+`",
        "win": "alt+`",
        "when": "explorerViewletFocus && !inputFocus"
      },
      {
        "command": "quicklook.previewFile",
        "key": "alt+`",
        "win": "alt+`",
        "when": "editorTextFocus",
        "args": {
          "source": "activeEditor"
        }
      },
      {
        "command": "quicklook.previewFile",
        "key": "alt+`",
        "win": "alt+`",
        "when": "!editorTextFocus && !inputFocus && !sideBarFocus && !panelFocus && !terminalFocus && !auxiliaryBarFocus",
        "args": {
          "source": "activeEditor"
        }
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "quicklook.previewScmWorkingTree",
          "when": "false"
        },
        {
          "command": "quicklook.previewScmIndex",
          "when": "false"
        },
        {
          "command": "quicklook.previewScmUntracked",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "quicklook.previewFile",
          "when": "resourceScheme == file",
          "group": "navigation@10"
        }
      ],
      "editor/title": [
        {
          "command": "quicklook.previewFile",
          "when": "resourceScheme == file || resourceScheme == git",
          "group": "navigation@10"
        }
      ],
      "editor/title/context": [
        {
          "command": "quicklook.previewFile",
          "when": "resourceScheme == file || resourceScheme == git",
          "group": "navigation@10"
        }
      ],
      "editor/context": [
        {
          "command": "quicklook.previewFile",
          "when": "resourceScheme == file || resourceScheme == git",
          "group": "navigation@10"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "quicklook.previewScmWorkingTree",
          "when": "scmProvider == git && scmResourceGroup == workingTree",
          "group": "navigation@10"
        },
        {
          "command": "quicklook.previewScmIndex",
          "when": "scmProvider == git && scmResourceGroup == index",
          "group": "navigation@10"
        },
        {
          "command": "quicklook.previewScmUntracked",
          "when": "scmProvider == git && scmResourceGroup == untracked",
          "group": "navigation@10"
        }
      ]
    },
    "configuration": {
      "title": "QuickLook",
      "properties": {
        "quicklook.executablePath": {
          "type": "string",
          "default": "QuickLook.exe",
          "markdownDescription": "QuickLook executable command or full path. By default the extension searches `PATH` and common Installer or Scoop locations; set an explicit path for portable or custom installations."
        },
        "quicklook.previewOptions": {
          "type": "array",
          "default": [],
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "/pin",
              "/top",
              "-pin",
              "-top"
            ]
          },
          "markdownDescription": "Additional QuickLook command line options appended after the file path. Official options include `/pin` and `/top`."
        },
        "quicklook.useExplorerClipboardFallback": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Use VS Code's Copy Path command to resolve the focused Explorer selection when a keybinding does not provide a resource URI. The previous clipboard text is restored immediately."
        },
        "quicklook.markdownViewContinuity.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Remember and continue the last `source`, `preview`, or `split` Markdown view in this workspace. Disable to stop automatic Markdown view memory and layout changes; the current editor layout is left unchanged."
        },
        "quicklook.markdownInitialView": {
          "type": "string",
          "default": "preview",
          "enum": [
            "preview",
            "source",
            "split"
          ],
          "enumDescriptions": [
            "Start with VS Code's native rendered preview in one editor group.",
            "Start with the Markdown source editor in one editor group.",
            "Start with the source and VS Code's native live preview in two editor groups."
          ],
          "markdownDescription": "Sets the initial view only when this workspace has no remembered Markdown view. Later Markdown files reuse the last selected `source`, `preview`, or `split` view."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.91.0",
    "@vscode/vsce": "^3.2.2",
    "typescript": "^5.5.3"
  }
}
